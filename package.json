{
  "name": "dsh-qq-group-digest",
  "version": "0.5.1",
  "description": "DeepSeek-Harness 插件：监听指定 QQ 群消息，按阈值批次调用 DSH 已配置模型生成总结，并按群组织后私聊推送给指定好友。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.1.7-rc.2",
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "napcat",
    "onebot11",
    "qq"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  }
}
